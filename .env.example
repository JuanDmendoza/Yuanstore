# MongoDB Atlas
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/yuanstore?retryWrites=true&w=majority

# Cloudinary (solo el cloud name es necesario para construir URLs públicas)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=tu_cloud_name

# WhatsApp (formato internacional, sin "+" ni espacios; ej: 573001234567)
NEXT_PUBLIC_WHATSAPP_NUMBER=573000000000

# Secreto para firmar la sesión del admin (mín. 32 caracteres aleatorios)
SESSION_SECRET=
